from std.testing import assert_equal, assert_raises, TestSuite
from mcrypto.aead.aegis import encrypt, decrypt
from mcrypto.aead.algorithm import AegisAlgorithm


def hex_bytes(text: StaticString) -> List[UInt8]:
    var bytes = text.as_bytes()
    var output = List[UInt8](capacity=len(bytes) // 2)
    for i in range(0, len(bytes), 2):
        var high = Int(bytes[i])
        var low = Int(bytes[i + 1])
        high -= 48 if high <= 57 else 87
        low -= 48 if low <= 57 else 87
        output.append(UInt8(high * 16 + low))
    return output^


def _check_vector(
    algorithm: AegisAlgorithm,
    key_hex: StaticString,
    nonce_hex: StaticString,
    message_hex: StaticString,
    aad_hex: StaticString,
    ciphertext_hex: StaticString,
    tag_hex: StaticString,
) raises:
    var key = hex_bytes(key_hex)
    var nonce = hex_bytes(nonce_hex)
    var message = hex_bytes(message_hex)
    var aad = hex_bytes(aad_hex)
    var sealed = encrypt(
        algorithm, Span(key), Span(nonce), Span(aad), Span(message)
    )
    assert_equal(sealed[0], hex_bytes(ciphertext_hex))
    assert_equal(sealed[1], hex_bytes(tag_hex))
    var ciphertext = sealed[0].copy()
    var tag = sealed[1].copy()
    assert_equal(
        decrypt(
            algorithm,
            Span(key),
            Span(nonce),
            Span(aad),
            Span(ciphertext),
            Span(tag),
        ),
        message,
    )


def test_aegis128l_interop_partial_vector() raises:
    var key = hex_bytes("e343d75de99e6d73543968437d3dcf6a")
    var nonce = hex_bytes("317a5808ed5debf6f527a780e0896b2d")
    var message = hex_bytes(
        "247045cb40dea9c514a885444c526ac867b1b80e4728a23b63f596"
    )
    var aad = hex_bytes("323094c01e")
    var expected_ciphertext = hex_bytes(
        "18cb5d2fc5e27bdda5ba16f1320da42049759368548e5bd96f2dbc"
    )
    var expected_tag = hex_bytes(
        "5d3e88816daf20f11018456b58b2614050b93b222f03be079b39a9bb2de49f47"
    )
    var sealed = encrypt(
        AegisAlgorithm.AEGIS128L,
        Span(key),
        Span(nonce),
        Span(aad),
        Span(message),
    )
    assert_equal(sealed[0], expected_ciphertext)
    assert_equal(sealed[1], expected_tag)
    var ciphertext = sealed[0].copy()
    var tag = sealed[1].copy()
    assert_equal(
        decrypt(
            AegisAlgorithm.AEGIS128L,
            Span(key),
            Span(nonce),
            Span(aad),
            Span(ciphertext),
            Span(tag),
        ),
        message,
    )
    tag[0] ^= 1
    with assert_raises():
        _ = decrypt(
            AegisAlgorithm.AEGIS128L,
            Span(key),
            Span(nonce),
            Span(aad),
            Span(ciphertext),
            Span(tag),
        )


def test_aegis256_interop_partial_vector() raises:
    var key = hex_bytes(
        "b8c6e8cea59ca9fd2922530ee61911c1ed1c5af98be8fb03cbb449adcea0ed83"
    )
    var nonce = hex_bytes(
        "af5bc1abe7bafadee790390277874cdfcc1ac1955f249d1131555d345832f555"
    )
    var message = hex_bytes("b6c15f560be043d06aa27e15d8c901af6b19db7a15e1")
    var aad = hex_bytes(
        "d899366a0b4e4d86cce5ba61aca2a84349c8de5757e008e94e7d7a3703"
    )
    var expected_ciphertext = hex_bytes(
        "4c8496dfa6c419ef3c4867769a9014bd17118c22eef5"
    )
    var expected_tag = hex_bytes(
        "f81ceacaaae6263c33f836fa26d92b0f08eb0796135c7fe312c93add6a208e8a"
    )
    var sealed = encrypt(
        AegisAlgorithm.AEGIS256,
        Span(key),
        Span(nonce),
        Span(aad),
        Span(message),
    )
    assert_equal(sealed[0], expected_ciphertext)
    assert_equal(sealed[1], expected_tag)
    var ciphertext = sealed[0].copy()
    var tag = sealed[1].copy()
    assert_equal(
        decrypt(
            AegisAlgorithm.AEGIS256,
            Span(key),
            Span(nonce),
            Span(aad),
            Span(ciphertext),
            Span(tag),
        ),
        message,
    )
    ciphertext[0] ^= 1
    with assert_raises():
        _ = decrypt(
            AegisAlgorithm.AEGIS256,
            Span(key),
            Span(nonce),
            Span(aad),
            Span(ciphertext),
            Span(tag),
        )


def test_aegis_empty_and_16_byte_tags() raises:
    var empty = List[UInt8]()
    var empty_message = List[UInt8]()
    var key128 = List[UInt8](length=16, fill=0)
    var nonce128 = List[UInt8](length=16, fill=0)
    var full128 = encrypt(
        AegisAlgorithm.AEGIS128L,
        Span(key128),
        Span(nonce128),
        Span(empty),
        Span(empty_message),
    )
    assert_equal(
        full128[1],
        hex_bytes(
            "bcbaebb524d1dae04c6a8c6ef5de2991972645c965deed1cf4b2faff4fe777cc"
        ),
    )
    var sealed128 = encrypt(
        AegisAlgorithm.AEGIS128L,
        Span(key128),
        Span(nonce128),
        Span(empty),
        Span(empty_message),
        16,
    )
    assert_equal(len(sealed128[0]), 0)
    assert_equal(len(sealed128[1]), 16)
    var ciphertext128 = sealed128[0].copy()
    var tag128 = sealed128[1].copy()
    assert_equal(
        decrypt(
            AegisAlgorithm.AEGIS128L,
            Span(key128),
            Span(nonce128),
            Span(empty),
            Span(ciphertext128),
            Span(tag128),
        ),
        empty,
    )
    var key256 = List[UInt8](length=32, fill=0)
    var nonce256 = List[UInt8](length=32, fill=0)
    var full256 = encrypt(
        AegisAlgorithm.AEGIS256,
        Span(key256),
        Span(nonce256),
        Span(empty),
        Span(empty_message),
    )
    assert_equal(
        full256[1],
        hex_bytes(
            "eaebb9f2544a6ecff03922b4b46b47e71d4b3e7d3cf766f1705c17f4c5976024"
        ),
    )
    var sealed256 = encrypt(
        AegisAlgorithm.AEGIS256,
        Span(key256),
        Span(nonce256),
        Span(empty),
        Span(empty_message),
        16,
    )
    assert_equal(len(sealed256[0]), 0)
    assert_equal(len(sealed256[1]), 16)
    var ciphertext256 = sealed256[0].copy()
    var tag256 = sealed256[1].copy()
    assert_equal(
        decrypt(
            AegisAlgorithm.AEGIS256,
            Span(key256),
            Span(nonce256),
            Span(empty),
            Span(ciphertext256),
            Span(tag256),
        ),
        empty,
    )


