from std.testing import assert_equal, assert_true, assert_raises, TestSuite
from mcrypto.compression.algorithm import (
    CompressionTransform,
    parse_compression_transform,
)
from mcrypto.compression.transforms import transform, deflate, inflate


def _corpus() -> List[List[UInt8]]:
    var empty = List[UInt8]()
    var repeated = List[UInt8](length=4096, fill=0xA5)
    var sequence = List[UInt8](capacity=8192)
    for i in range(8192):
        sequence.append(UInt8(i & 255))
    var mixed = List[UInt8](capacity=6000)
    for i in range(6000):
        mixed.append(UInt8((i * 73 + (i // 7) * 19) & 255))
    return [empty^, repeated^, sequence^, mixed^]


def test_roundtrip_corpus() raises:
    var corpus = _corpus()
    for message in corpus:
        var raw = deflate(Span(message))
        assert_equal(inflate(Span(raw)), message)
        for compressor, decompressor in [
            (
                CompressionTransform.ZLIB_COMPRESS,
                CompressionTransform.ZLIB_DECOMPRESS,
            ),
            (CompressionTransform.GZIP, CompressionTransform.GUNZIP),
        ]:
            var encoded = transform(compressor, Span(message))
            assert_equal(transform(decompressor, Span(encoded)), message)
    var compressible = List[UInt8](length=4096, fill=7)
    assert_true(len(deflate(Span(compressible))) < 100)


