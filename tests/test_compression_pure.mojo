        77,
        251,
        175,
        236,
        47,
    ]
    var expected = List[UInt8]()
    for _ in range(50):
        for (
            byte
        ) in "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. ".as_bytes():
            expected.append(byte)
    assert_equal(inflate(Span(raw)), expected)
    # RFC 1951 stored block carrying "hello".
    var stored: List[UInt8] = [1, 5, 0, 250, 255, 104, 101, 108, 108, 111]
    assert_equal(inflate(Span(stored)), List("hello".as_bytes()))
    # RFC 1950 zlib stream generated by zlib for "hello".
    var zlib_vector: List[UInt8] = [
        120,
        156,
        203,
        72,
        205,
        201,
        201,
        7,
        0,
        6,
        44,
        2,
        21,
    ]
    assert_equal(
        transform(CompressionTransform.ZLIB_DECOMPRESS, Span(zlib_vector)),
        List("hello".as_bytes()),
    )
    # Deterministic RFC 1952-compatible gzip member generated by Python gzip.
    var gz: List[UInt8] = [
        31,
        139,
        8,
        0,
        0,
        0,
        0,
        0,
        2,
        255,
        203,
        72,
        205,
        201,
        201,
        7,
        0,
        134,
        166,
        16,
        54,
        5,
        0,
        0,
        0,
    ]
    assert_equal(
        transform(CompressionTransform.GUNZIP, Span(gz)),
        List("hello".as_bytes()),
    )


def test_concatenated_gzip_members() raises:
    var left = transform(CompressionTransform.GZIP, "hello ".as_bytes())
    var right = transform(CompressionTransform.GZIP, "world".as_bytes())
    for byte in right:
        left.append(byte)
    assert_equal(
        transform(CompressionTransform.GUNZIP, Span(left)),
        List("hello world".as_bytes()),
    )


def test_validation_errors() raises:
    var payload = List("checksum validation".as_bytes())
    var z = transform(CompressionTransform.ZLIB_COMPRESS, Span(payload))
    z[len(z) - 1] ^= 1
    with assert_raises():
        _ = transform(CompressionTransform.ZLIB_DECOMPRESS, Span(z))
    var g = transform(CompressionTransform.GZIP, Span(payload))
    g[len(g) - 8] ^= 1
    with assert_raises():
        _ = transform(CompressionTransform.GUNZIP, Span(g))
    var truncated = transform(CompressionTransform.GZIP, Span(payload))
    _ = truncated.pop()
    with assert_raises():
        _ = transform(CompressionTransform.GUNZIP, Span(truncated))
    var invalid_stored: List[UInt8] = [1, 1, 0, 0, 0, 65]
    with assert_raises():
        _ = inflate(Span(invalid_stored))
    with assert_raises():
        _ = parse_compression_transform("unknown")


def main() raises:
    TestSuite.discover_tests[__functions_in_module()]().run()
