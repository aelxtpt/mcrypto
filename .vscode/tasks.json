{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build hkdf tests",
      "type": "process",
      "command": "pixi",
      "args": [
        "run",
        "mojo",
        "build",
        "-O0",
        "-g",
        "-D",
        "ASSERT=all",
        "-I",
        "src",
        "tests/test_hkdf.mojo",
        "-o",
        ".pixi/test_hkdf_debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
